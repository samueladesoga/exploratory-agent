{
  "manifest_version": 3,
  "name": "Exploratory Agent",
  "version": "0.1.0",
  "description": "An AI exploratory tester for the site you're on. Bring your own Anthropic API key.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Exploratory Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
